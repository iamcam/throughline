# Database — local dev only (Docker uses DB_* vars from project root .env)
# Make sure the DB_USER and DB_PASSWORD match those in DATABASE_URLs.
# They are used in different places/purposes
DB_USER=postgres
DB_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/podcast_engine

# Queue
# empty = BackgroundTaskQueue; set = StreaqQueue; docker redis address: redis://redis:6379
REDIS_URL=redis://localhost:6379
MAX_CONCURRENT_INGESTIONS=1

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# LLM — any OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=llama3.1:8b

# Embeddings: OpenAI-compatible API url; "local" to run local embedding; empty to fall back to the LLM configuration
# !IMPORTANT! EMBEDDING_BACKEND, EMBEDDING_MODEL_NAME, and EMBEDDING_DIMENSIONS must match in api and worker deployments.
# See backend/README.md for details.
EMBEDDING_BASE_URL=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIMENSIONS=768

EMBEDDING_MAX_INPUT_TOKENS=8000 # Check the embedder for limits and set a value below it with room to spare; Default 8000 for OpenAI text-embedding- models and Nomic Embed

# Transcription

# Leave empty to use local Whisper
TRANSCRIPTION_SERVICE_URL=
# Required for OpenAI; leave empty for local or unauthenticated services
TRANSCRIPTION_API_KEY=

# Local Whisper config — ignored when TRANSCRIPTION_SERVICE_URL is set
# faster_whisper | mlx_whisper
WHISPER_BACKEND=faster_whisper
# model size or HF repo e.g. mlx-community/whisper-medium-mlx
WHISPER_MODEL=medium

TRANSCRIPTION_MIN_SEGMENT_WORDS=5
TRANSCRIPTION_MAX_SEGMENT_TOKENS=200
TRANSCRIPTION_PAUSE_THRESHOLD_S=1.2

# ProcessPoolExecutor size for local Whisper
PIPELINE_MAX_WORKERS=1


# Speaker inference

# look-back before a speaker's first utterance, to catch how they were introduced
SPEAKER_INFERENCE_PADDING_MS=60000


# Observability — disabled by default, see backend/README.md
TRACING_ENABLED=false
OTEL_ENDPOINT=http://localhost:6006/v1/traces
OTEL_API_KEY=
OTEL_PROJECT_NAME=podcast-engine

# Demo auth — disabled by default
# If enabled, DEMO_USERNAME and DEMO_PASSWORD must be changed from defaults
DEMO_AUTH_ENABLED=false
DEMO_USERNAME=demo
DEMO_PASSWORD=changeme